<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FlightWatch</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FlightWatch.styles.css" asp-append-version="true" />
</head>
<body class="@(ViewData["Title"]?.ToString() == "FlightWatch" ? "flightwatch-page" : "")">
    <header>
        <nav class="fw-navbar">
            <div class="fw-navbar-inner">
                <a class="fw-brand" asp-area="" asp-controller="Home" asp-action="Index">FlightWatch</a>
                <button class="fw-toggler navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse fw-nav-links">
                    <ul class="fw-nav-list">
                        <li><a class="fw-nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a></li>
                        <li><a class="fw-nav-link" asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a></li>
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    @if (ViewData["Title"]?.ToString() == "FlightWatch")
    {
        <div class="container">
            @RenderBody()
        </div>
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
        <footer class="fw-footer">
            <div class="container">
                &copy; 2026 - FlightWatch - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (ViewData["Title"]?.ToString() != "FlightWatch")
    {
        <script src="~/js/site.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>