<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FlightWatch</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/FlightWatch.styles.css" asp-append-version="true" />
</head>
<body class="@(ViewData["Title"]?.ToString() == "FlightWatch" ? "flightwatch-page" : "")">
    <header>
        <nav class="fw-navbar">
            <div class="fw-navbar-inner">
                <span class="fw-brand">FlightWatch</span>

                @if (ViewData["Title"]?.ToString() == "FlightWatch")
                {
                    <div id="search-container">
                        <i class="bi bi-search" style="color:#888; font-size:14px;"></i>
                        <input type="text" id="flight-search" placeholder="Search callsign or ICAO24..." />
                        <button id="search-btn">Search</button>
                        <div id="search-results"></div>
                    </div>

                    <div id="flights-counter">
                        ✈️ Flights: <strong id="count">Loading...</strong>
                    </div>
                }
            </div>
        </nav>
    </header>

    @if (ViewData["Title"]?.ToString() == "FlightWatch")
    {
        <div class="container">
            @RenderBody()
        </div>
    }
    else
    {
        <div class="container">
            <main role="main" class="pb-3">
                @RenderBody()
            </main>
        </div>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @if (ViewData["Title"]?.ToString() != "FlightWatch")
    {
        <script src="~/js/site.js" asp-append-version="true"></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>