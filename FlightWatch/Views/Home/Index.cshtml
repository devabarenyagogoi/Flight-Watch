@{
    ViewData["Title"] = "FlightWatch";
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css" />
<link href="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.css" rel="stylesheet" />
<script src="https://unpkg.com/maplibre-gl@4.7.1/dist/maplibre-gl.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/suncalc/1.9.0/suncalc.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/7.0.5/signalr.min.js"></script>

<div id="map"></div>

<!-- Left Sidebar: Country Filter -->
<div id="left-sidebar">
    <div id="left-sidebar-header">
        <strong>Filter by Country</strong>
        <button id="left-sidebar-close" onclick="closeLeftSidebar()">✕</button>
    </div>
    <div id="left-sidebar-body">
        <input type="text" id="country-search" placeholder="Search countries..." />
        <div id="country-list"></div>
    </div>
</div>

<button id="left-sidebar-toggle" onclick="toggleLeftSidebar()">
    <i class="bi bi-funnel-fill"></i>
</button>

<!-- Right Sidebar: Flight Info -->
<div id="right-sidebar">
    <div id="right-sidebar-header">
        <strong id="right-sidebar-callsign">Unknown</strong>
        <button id="right-sidebar-close" onclick="closeRightSidebar()">✕</button>
    </div>
    <div id="right-sidebar-body">
        <img id="sb-photo" src="" alt="" style="width:100%; border-radius:6px; margin-bottom:12px; display:none;" />
        <table>
            <tr><td colspan="2" style="color:#aaa; font-size:11px; padding-bottom:4px;">ROUTE</td></tr>
            <tr><td>Route</td><td id="sb-route"></td></tr>
            <tr><td>Origin</td><td id="sb-origin"></td></tr>
            <tr><td>Origin IATA</td><td id="sb-origin-iata"></td></tr>
            <tr><td>Origin City</td><td id="sb-origin-city"></td></tr>
            <tr><td>Origin Country</td><td id="sb-origin-country"></td></tr>
            <tr><td>Destination</td><td id="sb-destination"></td></tr>      
            <tr><td>Dest IATA</td><td id="sb-dest-iata"></td></tr>
            <tr><td>Dest City</td><td id="sb-dest-city"></td></tr>
            <tr><td>Dest Country</td><td id="sb-dest-country"></td></tr>
            <tr><td>Airline</td><td id="sb-airline"></td></tr>
            <tr><td colspan="2" style="color:#aaa; font-size:11px; padding-top:20px; padding-bottom:4px;">AIRCRAFT</td></tr>
            <tr><td>Type</td><td id="sb-type"></td></tr>
            <tr><td>ICAO Type</td><td id="sb-icao-type"></td></tr>
            <tr><td>Manufacturer</td><td id="sb-manufacturer"></td></tr>
            <tr><td>Registration</td><td id="sb-registration"></td></tr>
            <tr><td>Owner</td><td id="sb-owner"></td></tr>
            <tr><td>Country</td><td id="sb-country"></td></tr>
            <tr><td colspan="2" style="color:#aaa; font-size:11px; padding-top:20px; padding-bottom:4px;">LIVE DATA</td></tr>
            <tr><td>Altitude</td><td id="sb-altitude"></td></tr>
            <tr><td>Geo Altitude</td><td id="sb-geo-altitude"></td></tr>
            <tr><td>Speed</td><td id="sb-speed"></td></tr>
            <tr><td>Heading</td><td id="sb-heading"></td></tr>
            <tr><td>Vertical Rate</td><td id="sb-vrate"></td></tr>
            <tr><td>On Ground</td><td id="sb-ground"></td></tr>
            <tr><td>Squawk</td><td id="sb-squawk"></td></tr>
            <tr><td>ICAO24</td><td id="sb-icao"></td></tr>
            <tr><td>Position Source</td><td id="sb-source"></td></tr>
            <tr><td>Category</td><td id="sb-category"></td></tr>
            <tr><td>SPI</td><td id="sb-spi"></td></tr>
            <tr><td>Last Contact</td><td id="sb-contact"></td></tr> 
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}